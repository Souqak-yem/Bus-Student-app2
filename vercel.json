{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!manifest.json|site-meta.json|og-image.png|app-icon.svg|full-logo.svg|favicon.ico|icons/).*)",
      "destination": "/index.html"
    }
  ]
}
